<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<AnchorPane fx:controller="com.example.demo.ProductCardController"
            fx:id="cardRoot"
            onMouseClicked="#handleClick"
            styleClass="product-card" xmlns:fx="http://javafx.com/fxml">

    <VBox alignment="TOP_CENTER" spacing="5"
          prefWidth="175" prefHeight="230"
          minWidth="175" minHeight="230"
          maxWidth="175" maxHeight="230">
        <Label fx:id="nameLabel" styleClass="product-name"
               maxWidth="Infinity" />
        <Label fx:id="descriptionLabel" styleClass="product-description"
               maxWidth="Infinity" />
        <ImageView   fx:id="imageView" fitWidth="160" fitHeight="160"/>
        <HBox spacing="5" styleClass="bar-des" alignment="CENTER">
            <Label fx:id="brandLabel" styleClass="product-brand" alignment="CENTER"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="priceLabel" styleClass="product-price" alignment="CENTER_RIGHT"/>
        </HBox>
    </VBox>
</AnchorPane>
